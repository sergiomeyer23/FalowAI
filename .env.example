# Frontend server-side proxy. Browser code uses relative /api/v1 URLs.
BACKEND_INTERNAL_URL=http://localhost:8080
NEXT_PUBLIC_API_BASE_URL=/api/v1

# Backend
SERVER_PORT=8080
DATABASE_URL=jdbc:postgresql://localhost:5432/falow
DATABASE_USERNAME=falow
DATABASE_PASSWORD=change-me
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Optional AI provider. Keep secrets server-side only.
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Auth for the personal installation
JWT_SECRET=replace-with-a-long-random-secret
